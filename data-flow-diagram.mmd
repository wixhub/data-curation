        QC["GeospatialQcEngine\ngeospatial-qc.engine.ts"]
        DB["DatabaseService\nIndexedDB via Dexie"]
    end

    subgraph Presentation["UI / Visualization"]
        Grid["Data Grid\nfeatures/data-grid/data-grid.ts"]
        MapUI["Map Inspector\nfeatures/map-inspector/map-inspector.ts"]
        MapSvc["LeafletMapService\nmap.service.ts"]
        Export["Export utils\nexport.utils.ts"]
    end

    S1 --> APIService
    S2 --> Parser
    APIService --> StateService
